{
  "name": "skugga-browser",
  "version": "0.1.36",
  "description": "Skugga – Vaka som går helt genom Tor (demo)",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:mac": "electron-packager . \"Skugga\" --platform=darwin --arch=x64 --out=dist --overwrite --app-bundle-id=se.skugga.browser --ignore=\"(dist|/\\.git|meta_test\\.js|scan_test\\.js|.*\\.md)\"",
    "build:linux": "electron-builder --linux --x64",
    "build:win": "electron-builder --win --x64"
  },
  "author": "Cetto",
  "license": "UNLICENSED",
  "dependencies": {
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "github:castlabs/electron-releases#v43.2.0+wvcus",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "se.skugga.browser",
    "productName": "Skugga",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist-installer/**",
      "!build/**",
      "!*.md",
      "!meta_test.js",
      "!scan_test.js",
      "!repro_chatgpt.js",
      "!tor-bundle/**",
      "!**/*.map",
      "!**/.git/**"
    ],
    "extraResources": [
      {
        "from": "tor-bundle",
        "to": "tor-bundle"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Skugga-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "Skugga.AppImage",
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "northcrafto",
        "repo": "skugga-dl",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skugga",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "electronDist": "/home/mint/.castlabs-electron-dist",
    "asarUnpack": [
      "native/**"
    ]
  }
}
